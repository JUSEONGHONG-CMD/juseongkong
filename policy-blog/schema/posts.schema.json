{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-blog/posts.schema.json",
  "title": "정책 블로그 원고 묶음",
  "description": "원고 한 편 = 대표 인물 한 명의 정책 나열(총정리). 정책 칸(items)을 같은 형식으로 나란히 보여 준다. 실제 개인정보는 넣지 않는다. 인물은 personas.json 의 가상 인물만 쓴다.",
  "type": "object",
  "required": [
    "schema_version",
    "posts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scan": {
      "type": "object",
      "description": "점검 메타. posts 가 비어 있을 때 '새 정책 없음' 메일에 쓴다",
      "properties": {
        "focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/post"
      }
    }
  },
  "$defs": {
    "verification_pass": {
      "type": "object",
      "required": [
        "status",
        "sources_checked"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "failed",
            "unverifiable"
          ]
        },
        "sources_checked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "fixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "post": {
      "type": "object",
      "required": [
        "id",
        "persona_id",
        "search_name",
        "title",
        "one_liner",
        "intro",
        "list_short",
        "hashtags",
        "outro",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "roundup-<인물코드>"
        },
        "persona_id": {
          "enum": [
            "young_single",
            "newlywed",
            "parenting",
            "senior"
          ]
        },
        "search_name": {
          "type": "string",
          "description": "원고 이름(예: 신혼부부 지원정책). title·one_liner·intro 가 이것으로 시작해야 한다"
        },
        "title": {
          "type": "string"
        },
        "one_liner": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "list_short": {
          "type": "string",
          "description": "썸네일 아래 띠에 쓰는 나열한 정책 요약"
        },
        "thumb_action": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "outro": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "agency",
        "search_name",
        "one_liner",
        "target_short",
        "support_short",
        "method_short",
        "criteria",
        "persona",
        "benefits",
        "drawbacks",
        "how_to_apply",
        "apply_url",
        "notice_url",
        "deadline",
        "sources",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "<기관>-<제도>[-지역]-<인물코드>"
        },
        "kind": {
          "enum": [
            "new",
            "update"
          ],
          "description": "blog_state.py merge 가 이력 기준으로 다시 맞춘다"
        },
        "name": {
          "type": "string"
        },
        "agency": {
          "type": "string"
        },
        "search_name": {
          "type": "string"
        },
        "one_liner": {
          "type": "string"
        },
        "target_short": {
          "type": "string"
        },
        "support_short": {
          "type": "string"
        },
        "method_short": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "requirement",
              "detail"
            ],
            "properties": {
              "requirement": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "persona": {
          "type": "object",
          "required": [
            "fit",
            "story",
            "benefit_estimate"
          ],
          "properties": {
            "fit": {
              "enum": [
                "yes",
                "partial"
              ]
            },
            "story": {
              "type": "string"
            },
            "benefit_estimate": {
              "type": "string",
              "description": "금액은 계산 가정을 함께 적는다"
            }
          }
        },
        "benefits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "drawbacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "how_to_apply": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "apply_url": {
          "type": "string"
        },
        "notice_url": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documents_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "type": "object",
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "pass1",
            "pass2"
          ],
          "properties": {
            "pass1": {
              "$ref": "#/$defs/verification_pass"
            },
            "pass2": {
              "$ref": "#/$defs/verification_pass"
            }
          }
        }
      }
    }
  }
}